@{
    Layout = null; // Walang navbar/footer
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Genshin Character Build</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">

    <div class="login-wrapper">
        <div class="login-card">

            <!-- Left Banner Image -->
            <div class="login-banner">
                <img src="~/images/genshin-left-panel.jpg" alt="Genshin Landscape" class="img-fluid" />
            </div>

            <!-- Right Form -->
            <div class="login-form-container">
                <h2 class="login-title">Login</h2>

                <!-- ERROR MESSAGE -->
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger py-2 text-center mb-3" style="font-size: 0.85rem; border-radius: 8px;">
                        @ViewBag.ErrorMessage
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post">
                    <div class="mb-3 text-start">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" value="@ViewBag.EnteredEmail" class="form-control custom-input" placeholder="Enter your email" required />
                    </div>

                    <div class="mb-2 text-start">
                        <label class="form-label">Password</label>
                        <input type="password" name="password" class="form-control custom-input" placeholder="Enter your password" required />
                    </div>

                    <div class="text-end mb-4">
                        <a href="#" class="forgot-password">forgot password?</a>
                    </div>

                    <button type="submit" class="btn custom-btn">Log in</button>
                </form>

                <div class="divider">
                    <span>or continue with</span>
                </div>

                <div class="social-login">
                    <a href="#" class="social-btn"><i class="fab fa-google text-danger"></i></a>
                    <a href="#" class="social-btn"><i class="fab fa-facebook-f text-primary"></i></a>
                    <a href="#" class="social-btn"><i class="fab fa-apple text-dark"></i></a>
                </div>

                <div class="presented-by">
                    <span>presented by <strong>GenshinBuilds</strong></span>
                </div>
            </div>

        </div>
    </div>

</body>
</html>