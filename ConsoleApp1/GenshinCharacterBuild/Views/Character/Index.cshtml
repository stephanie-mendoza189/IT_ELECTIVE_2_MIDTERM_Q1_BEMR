@model IEnumerable<GenshinCharacterBuild.Models.Character>

@{
    ViewData["Title"] = "Character Builds";
}

<div class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <h2>Genshin Impact Top Tier Builds</h2>

        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-outline-danger">Logout</button>
        </form>
    </div>

    @{
        async Task RenderRoleTable(string roleTitle, string roleFilter, string headerColorClass)
        {
            var filteredCharacters = Model.Where(c => c.Role == roleFilter).ToList();

            <div class="card mb-5 shadow-sm">
                <div class="card-header @headerColorClass text-white">
                    <h4 class="mb-0">@roleTitle</h4>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 80px;"></th>
                                    <th>Name</th>
                                    <th>Element</th>
                                    <th>Best Weapon</th>
                                    <th>Best Artifact Set</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var character in filteredCharacters)
                                {
                                    <tr>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(character.ImageUrl))
                                            {
                                                <img src="~/images/characters/@character.ImageUrl" alt="@character.Name" class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover; border: 2px solid #ddd;" />
                                            }
                                        </td>
                                        <td class="fw-bold">@character.Name</td>
                                        <td>
                                            <span class="badge bg-secondary">@character.Element</span>
                                        </td>
                                        <td>@character.BestWeapon</td>
                                        <td>@character.BestArtifact</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }

    @{
        await RenderRoleTable("Main DPS", "Main DPS", "bg-danger");
        await RenderRoleTable("Sub-DPS", "Sub-DPS", "bg-info text-dark");
        await RenderRoleTable("Support", "Support", "bg-success");
    }
</div>